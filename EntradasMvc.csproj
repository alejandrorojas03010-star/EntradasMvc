<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- HeroesWeb es otro proyecto del repositorio: no se compila como parte de EntradasMvc -->
    <DefaultItemExcludes>$(DefaultItemExcludes);HeroesWeb/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
